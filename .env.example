APP_NAME=test
APP_ENV=local
APP_DEBUG=true

SERVER_URI=localhost
SERVER_PORT=57898

# Currently supported mysql, postgres, and mssql
DB_MAIN_CONNECTION=postgres
DB_MAIN_HOSTNAME=127.0.0.1
DB_MAIN_PORT=5432
DB_MAIN_DATABASE=db_name
DB_MAIN_USERNAME=root
DB_MAIN_PASSWORD=
DB_MAIN_MODEL_PATH="../model/entity"

DB_EXTENSION_CONNECTION=postgres
DB_EXTENSION_HOSTNAME=127.0.0.1
DB_EXTENSION_PORT=5432
DB_EXTENSION_DATABASE=postgres
DB_EXTENSION_USERNAME=postgres
DB_EXTENSION_PASSWORD=root

MEMCACHE_MAIN_HOSTNAME=localhost
MEMCACHE_MAIN_PORT=6379
MEMCACHE_MAIN_PASSWORD=
MEMCACHE_MAIN_DB_CLUSTER=0
MEMCACHE_MAIN_ENABLE=false

MONGODB_HOSTNAME=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=
MONGODB_USERNAME=root
MONGODB_PASSWORD=

RABBITMQ_CONNECTION_STRING_MAIN=amqp://username:password@127.0.0.1:5672
# Driver examples:
# - AMQP  : MESSAGING_MAIN_DRIVER=amqp + RABBITMQ_CONNECTION_STRING_MAIN
# - REDIS : MESSAGING_MAIN_DRIVER=redis + MESSAGING_MAIN_HOSTNAME/PORT/DB
# - KAFKA : MESSAGING_MAIN_DRIVER=kafka + MESSAGING_MAIN_BROKERS
# - MQTT  : MESSAGING_MAIN_DRIVER=mqtt + MESSAGING_MAIN_PROTOCOL/HOSTNAME/PORT
MESSAGING_MAIN_DRIVER=amqp
MESSAGING_MAIN_HOSTNAME=127.0.0.1
MESSAGING_MAIN_PORT=5672
MESSAGING_MAIN_USERNAME=
MESSAGING_MAIN_PASSWORD=
MESSAGING_MAIN_DB=0
MESSAGING_MAIN_BROKERS=127.0.0.1:9092
MESSAGING_MAIN_CLIENT_ID=cuakx-boilerplate
MESSAGING_MAIN_PROTOCOL=mqtt
MESSAGING_MAIN_ENABLE=false
EXAMPLE_EVENT_TOPIC=example-event-topic
EXAMPLE_EVENT_CONNECTION=main
EXAMPLE_EVENT_GROUP_ID=example-event-group

HEARTBEAT_CRON=* * * * *

SECURITY_THROTTLING_ENABLE=true
SECURITY_THROTTLING_WINDOW_MS=60000
SECURITY_THROTTLING_MAX_REQUESTS=80
SECURITY_CSRF_ENABLE=true
SECURITY_CSRF_HEADER=x-csrf-token
SECURITY_CSRF_METHODS=POST,PUT,PATCH,DELETE
SECURITY_CSRF_SECRET=change-me
SECURITY_PURIFIER_ENABLE=true
SECURITY_PURIFIER_BODY=true
SECURITY_PURIFIER_QUERY=true
SECURITY_PURIFIER_PARAMS=true

LOG_DRIVER=local
LOG_DIRECTORY=./logs
LOGSTASH_ENABLE=false
LOGSTASH_HOST=127.0.0.1
LOGSTASH_PORT=5000
LOGSTASH_PROTOCOL=udp

NOTIFICATION_SMTP_ENABLE=false
NOTIFICATION_SMTP_HOST=127.0.0.1
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM=no-reply@example.com
NOTIFICATION_FCM_ENABLE=false
NOTIFICATION_FCM_ENDPOINT=https://fcm.googleapis.com/v1/projects/project-id/messages:send
NOTIFICATION_FCM_BEARER_TOKEN=
NOTIFICATION_SENDINBLUE_ENABLE=false
NOTIFICATION_SENDINBLUE_API_KEY=
NOTIFICATION_SENDINBLUE_FROM_EMAIL=no-reply@example.com
NOTIFICATION_SENDINBLUE_FROM_NAME=Cuakx App
NOTIFICATION_SMS_ENABLE=false
NOTIFICATION_SMS_ENDPOINT=https://sms-provider.example/send
NOTIFICATION_SMS_API_KEY=
NOTIFICATION_WHATSAPP_ENABLE=false
NOTIFICATION_WHATSAPP_ENDPOINT=https://whatsapp-provider.example/send
NOTIFICATION_WHATSAPP_API_KEY=

FILE_DRIVER_DEFAULT=local
FILE_DRIVER_LOCAL_ROOT_PATH=./storage
FILE_DRIVER_S3_REGION=us-east-1
FILE_DRIVER_S3_BUCKET=bucket-name
FILE_DRIVER_S3_ACCESS_KEY_ID=
FILE_DRIVER_S3_SECRET_ACCESS_KEY=
FILE_DRIVER_S3_ENDPOINT=
FILE_DRIVER_S3_FORCE_PATH_STYLE=false
FILE_DRIVER_MINIO_ENDPOINT=127.0.0.1
FILE_DRIVER_MINIO_PORT=9000
FILE_DRIVER_MINIO_USE_SSL=false
FILE_DRIVER_MINIO_ACCESS_KEY=
FILE_DRIVER_MINIO_SECRET_KEY=
FILE_DRIVER_MINIO_BUCKET=bucket-name

JWT_SECRET=secret

SWAGGER_ENABLE=true

