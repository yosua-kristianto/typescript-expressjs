APP_NAME=test
APP_ENV=local
APP_DEBUG=true

SERVER_URI=localhost
SERVER_PORT=57898

# Currently supported Knex and Sequelize
DB_ORM_DRIVER=sequelize

# Currently supported mysql, postgres, and mssql
DB_MAIN_CONNECTION=postgres
DB_MAIN_HOSTNAME=127.0.0.1
DB_MAIN_PORT=5432
DB_MAIN_DATABASE=db_name
DB_MAIN_USERNAME=root
DB_MAIN_PASSWORD=
DB_MAIN_MODEL_PATH="../model/entity"

DB_EXTENSION_CONNECTION=postgres
DB_EXTENSION_HOSTNAME=127.0.0.1
DB_EXTENSION_PORT=5432
DB_EXTENSION_DATABASE=postgres
DB_EXTENSION_USERNAME=postgres
DB_EXTENSION_PASSWORD=root

MEMCACHE_MAIN_HOSTNAME=localhost
MEMCACHE_MAIN_PORT=6379
MEMCACHE_MAIN_PASSWORD=
MEMCACHE_MAIN_DB_CLUSTER=0

MONGODB_HOSTNAME=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=
MONGODB_USERNAME=root
MONGODB_PASSWORD=

RABBITMQ_CONNECTION_STRING_MAIN=amqp://username:password@127.0.0.1:5672

JWT_SECRET=secret

SWAGGER_ENABLE=true

