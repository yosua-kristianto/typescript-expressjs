{
  "name": "cuakx-express",
  "version": "2.1.1",
  "description": "Cuakx Express is a highly structured and extensible backend boilerplate for modern backend services.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/main/Index.ts",
    "start": "node dist/main/Index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "db:init": "npx sequelize db:create",
    "migrate": "npx sequelize db:migrate",
    "migrate:rollback": "npx sequelize db:migrate:undo",
    "migrate:rollback:all": "npx sequelize db:migrate:undo:all",
    "migrate:refresh": "npx sequelize db:drop; npx sequelize db:create; npx sequelize db:migrate",
    "seed": "npx seed:all",
    "seed:refresh": "npm run migrate:refresh; npm run seed",
    "deploy:production": "npm run migrate; npm run build; npm run start",
    "deploy:production:dummies": "npm run migrate:refresh; npm run seed; npm run build; npm run start",
    "lint": "npx eslint ./src/main/*",
    "prepare": "husky install"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^14.18.21",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "eslint": "^8.40.0",
    "lint-staged": "^13.2.2",
    "nodemon": "^2.0.16",
    "ts-jest": "^29.0.3",
    "ts-node": "^9.1.1",
    "typescript": "4.6.4",
    "typescript-cli": "^0.1.0"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run lint"
    }
  },
  "dependencies": {
    "@babel/register": "^7.18.9",
    "@fastify/express": "^2.1.0",
    "@types/amqplib": "^0.10.1",
    "@types/axios": "^0.14.0",
    "@types/bluebird": "^3.5.36",
    "@types/dotenv": "^8.2.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.2.3",
    "@types/jwt-then": "^1.0.1",
    "@types/kafkajs": "^1.9.0",
    "@types/knex": "^0.16.1",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/validator": "^13.7.3",
    "amqplib": "^0.10.3",
    "dotenv": "^8.6.0",
    "express": "^4.18.1",
    "express-async-errors": "^3.1.1",
    "express-validator": "^6.14.1",
    "fastify": "^4.10.0",
    "husky": "^8.0.3",
    "ioredis": "^5.2.4",
    "jest": "^29.3.1",
    "jsonwebtoken": "^9.0.0",
    "knex": "^2.3.0",
    "mongoose": "^6.10.0",
    "mssql": "^9.0.1",
    "mysql2": "^3.14.1",
    "pg": "^8.7.3",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.20.1",
    "sequelize-cli": "^6.4.1",
    "sequelize-typescript": "^2.1.3",
    "swagger-jsdoc": "^6.2.5",
    "swagger-ui-express": "^4.5.0",
    "tedious": "^15.1.2"
  }
}
