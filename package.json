{
  "name": "cuakx-express-boilerplate",
  "version": "3.0.1",
  "description": "Cuakx Express is a highly structured and extensible backend boilerplate for modern backend services.",
  "main": "dist/main/Index.js",
  "types": "dist/main/Index.d.ts",
  "files": [
    "cuakx.sh",
    "cuakx",
    "cuakx.cmd",
    "cuakx.ps1",
    "dist",
    "readme.md",
    "LICENSE",
    "package.json",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register\" src/main/Index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "npm run build; node -r tsconfig-paths/register dist/main/Index.js",
    "test": "jest",
    "db:init": "npx sequelize db:create",
    "migrate": "npx sequelize db:migrate",
    "db:drop": "npx sequelize db:drop",
    "migrate:rollback": "npx sequelize db:migrate:undo",
    "migrate:rollback:all": "npx sequelize db:migrate:undo:all",
    "migrate:refresh": "npx sequelize db:drop; npx sequelize db:create; npx sequelize db:migrate",
    "seed": "npx sequelize db:seed:all",
    "migrate:refresh:seed": "npm run migrate:refresh; npm run seed",
    "deploy:production": "npm run migrate; npm run build; npm run start",
    "deploy:production:dummies": "npm run migrate:refresh; npm run seed; npm run build; npm run start",
    "lint": "npx eslint ./src/main/*",
    "prepare": "husky install"
  },
  "author": "Yosua Kristianto",
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-cli": "^0.1.0"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run lint"
    }
  },
  "dependencies": {
    "@babel/register": "^7.28.6",
    "@fastify/express": "^4.0.4",
    "@types/amqplib": "^0.10.8",
    "@types/axios": "^0.14.4",
    "@types/bluebird": "^3.5.42",
    "@types/dotenv": "^8.2.3",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jwt-then": "^1.0.4",
    "@types/kafkajs": "^1.9.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "amqplib": "^0.10.9",
    "cuakx-express-core": "^3.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "fastify": "^5.8.2",
    "husky": "^9.1.7",
    "ioredis": "^5.10.0",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0",
    "mssql": "^12.2.0",
    "mysql2": "^3.19.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sequelize-typescript": "^2.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tedious": "^19.2.1",
    "tsconfig-paths": "^4.2.0"
  }
}
