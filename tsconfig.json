{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",

    "rootDir": "src",
    "outDir": "dist",

    "baseUrl": "src",

    "paths": {
      "@api/*": ["main/api/*"],
      "@common/*": ["main/common/*"],
      "@config/*": ["main/config/*"],
      "@messaging/*": ["main/messaging/*"],
      "@model/*": ["main/model/*"],
      "@entity/*": ["main/model/entity/*"],
      "@repository/*": ["main/repository/*"],
      "@routes/*": ["main/routes/*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node", "jest"]
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}